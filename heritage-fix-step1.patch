new file mode 100644
index 0000000..d27c1e3
--- /dev/null
+++ b/apps/api/src/dotenv.ts
@@
+import path from "node:path";
+import { config } from "dotenv";
+import { z } from "zod";
+
+// Load environment variables from the repository root.  When running the
+// API from the monorepo root (e.g. via `pnpm dev`), process.cwd() will
+// point at the root and thus `.env` will be resolved correctly.  This
+// explicit load mirrors the behaviour of dotenv.config() in other files
+// but avoids scattering configuration throughout the codebase.
+config({ path: path.resolve(process.cwd(), ".env") });
+
+// Define the shape of required environment variables using zod.  Only
+// the critical variables needed at boot time are validated here.  All
+// other optional variables will simply pass through.  In production,
+// missing values will throw; in development, a warning is logged so
+// developers know which keys need to be set.
+const EnvSchema = z.object({
+  DATABASE_URL: z.string().min(1, "DATABASE_URL is required"),
+  JWT_SECRET: z.string().min(1, "JWT_SECRET is required"),
+  STRIPE_SECRET_KEY: z.string().optional(),
+  STRIPE_WEBHOOK_SECRET: z.string().optional(),
+  REDIS_URL: z.string().optional(),
+});
+
+export const env = (() => {
+  const parsed = EnvSchema.safeParse(process.env);
+  if (!parsed.success) {
+    // Aggregate all error messages into a single string
+    const msgs = parsed.error.issues
+      .map((i) => `${i.path.join(".")}: ${i.message}`)
+      .join("; ");
+    if (process.env.NODE_ENV === "production") {
+      // In production we fail fast when required vars are missing
+      throw new Error(`Invalid env: ${msgs}`);
+    } else {
+      // During development we log a warning to aid configuration
+      console.warn("[env] Missing/invalid env (dev allowed):", msgs);
+    }
+  }
+  return process.env as Record<string, string>;
+})();
+
+export default env;
