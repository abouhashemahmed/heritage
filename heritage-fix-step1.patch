@@
+import { PrismaClient } from "@prisma/client";
+
+// Create a single instance of PrismaClient.  Each instance of
+// PrismaClient maintains its own connection pool; creating multiple
+// instances can exhaust database connections, especially in
+// serverless or development environments where hot reloading occurs.
+// See the Prisma docs: your application should generally create only
+// one instance of PrismaClient【534956454671154†L141-L149】.
+const globalForPrisma = globalThis as unknown as {
+  prisma?: PrismaClient;
+};
+
+export const prisma =
+  globalForPrisma.prisma ??
+  new PrismaClient({
+    // Additional Prisma Client options can be provided here (e.g.
+    // log levels) but are omitted by default.  Override
+    // datasources via environment variables in .env.
+  });
+
+// In development, attach the Prisma client to the global object so
+// that it is reused across module reloads by ts-node/tsx.  In
+// production the global is not mutated.
+if (process.env.NODE_ENV !== "production") {
+  globalForPrisma.prisma = prisma;
+}
+
+export default prisma;
